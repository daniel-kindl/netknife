root = true

# Prefer opening braces on the next line where the language permits it.
# EditorConfig has no standard property for brace placement.
# Go requires same-line opening braces; use gofmt for Go files.

[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
